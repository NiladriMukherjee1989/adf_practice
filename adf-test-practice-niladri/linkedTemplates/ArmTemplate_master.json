{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-test-practice-niladri"
		},
		"LS_AZURE_STORAGE_ACCOUNT_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_AZURE_STORAGE_ACCOUNT'"
		},
		"LZ_AZURE_SQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LZ_AZURE_SQL'"
		},
		"LS_AZURE_STORAGE_ACCOUNT_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://demostroageniladri.dfs.core.windows.net/"
		},
		"LZ_AZURE_SQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-server-practice-niladri.database.windows.net"
		},
		"LZ_AZURE_SQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-practice"
		},
		"LZ_AZURE_SQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "niladri_mukherjee"
		},
		"FILE_BASED_TRIGGER_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/2add5b7e-e6f6-4f98-a83d-ea533c86d98c/resourceGroups/adf_practice_resource_group/providers/Microsoft.Storage/storageAccounts/demostroageniladri"
		},
		"trigger1_properties_PL_COPY_FILES_parameters_source_file": {
			"type": "string",
			"defaultValue": "@triggerBody().fileName"
		},
		"trigger1_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/2add5b7e-e6f6-4f98-a83d-ea533c86d98c/resourceGroups/adf_practice_resource_group/providers/Microsoft.Storage/storageAccounts/demostroageniladri"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-test-practice-niladri_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AZURE_STORAGE_ACCOUNT_accountKey": {
						"value": "[parameters('LS_AZURE_STORAGE_ACCOUNT_accountKey')]"
					},
					"LZ_AZURE_SQL_password": {
						"value": "[parameters('LZ_AZURE_SQL_password')]"
					},
					"LS_AZURE_STORAGE_ACCOUNT_properties_typeProperties_url": {
						"value": "[parameters('LS_AZURE_STORAGE_ACCOUNT_properties_typeProperties_url')]"
					},
					"LZ_AZURE_SQL_properties_typeProperties_server": {
						"value": "[parameters('LZ_AZURE_SQL_properties_typeProperties_server')]"
					},
					"LZ_AZURE_SQL_properties_typeProperties_database": {
						"value": "[parameters('LZ_AZURE_SQL_properties_typeProperties_database')]"
					},
					"LZ_AZURE_SQL_properties_typeProperties_userName": {
						"value": "[parameters('LZ_AZURE_SQL_properties_typeProperties_userName')]"
					},
					"FILE_BASED_TRIGGER_properties_typeProperties_scope": {
						"value": "[parameters('FILE_BASED_TRIGGER_properties_typeProperties_scope')]"
					},
					"trigger1_properties_PL_COPY_FILES_parameters_source_file": {
						"value": "[parameters('trigger1_properties_PL_COPY_FILES_parameters_source_file')]"
					},
					"trigger1_properties_typeProperties_scope": {
						"value": "[parameters('trigger1_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}